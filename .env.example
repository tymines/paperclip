DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Jarvis peer delegation: Ares (Box 2 / augibot2) ---
# War Room "Approve & send to team" → dispatchDelegation() POSTs to
# {JARVIS_PEER_ARES_URL}/jarvis/dispatch as identity "ares" (Bearer JARVIS_PEER_ARES_TOKEN),
# then Ares POSTs the result back to /jarvis/delegations/:id/result to flip the row to completed.
# Runtime values are set in ~/.paperclip/instances/default/.env on Box 1 (secret not committed).
# JARVIS_PEER_ARES_URL=http://augibot2s-mac-mini.tail1537c5.ts.net:18790
# JARVIS_PEER_ARES_TOKEN=<shared bearer; == AUGUST_GATEWAY_TOKEN on augibot2>
# PAPERCLIP_BRIDGE_LOCAL_API_URL=http://<box1-tailnet-ip>:3100   # so Ares can reach the result callback

# --- Jarvis peer delegation: Book Studio live agents (PR #30) ---
# Brainstorm/co-writer chat IS Calliope; the critic/review lane IS Hades.
# Tyler's law: there is NO raw-model fallback — an unreachable peer surfaces
# as a visible degraded failure with provenance in the UI.
#
# IMPORTANT: do NOT point these at the shared OpenClaw bridge (:18790). Its
# /jarvis/dispatch handler is a wire-up NOOP that always answers as "ares" —
# that would fabricate agent results. Run scripts/hermes-peer-bridge.mjs
# (see doc/BOOK-STUDIO-LIVE-AGENTS.md) and point both peers at it:
# JARVIS_PEER_CALLIOPE_URL=http://127.0.0.1:18791
# JARVIS_PEER_CALLIOPE_TOKEN=<shared bearer; == HERMES_PEER_BRIDGE_TOKEN on the shim host>
# JARVIS_PEER_CALLIOPE_MODEL=sol
# JARVIS_PEER_HADES_URL=http://127.0.0.1:18791
# JARVIS_PEER_HADES_TOKEN=<shared bearer; == HERMES_PEER_BRIDGE_TOKEN on the shim host>
# JARVIS_PEER_HADES_MODEL=kimi-k3
# Optional overrides:
# JARVIS_PEER_CALLIOPE_DISPATCH_PATH=/jarvis/dispatch   (default; per-peer override of JARVIS_DISPATCH_PATH)
# BOOK_CALLIOPE_TIMEOUT_MS=45000     # chat lane wait for the result callback
# BOOK_HADES_TIMEOUT_MS=120000       # critic lane wait for the result callback
# BOOK_AGENT_LANE_POLL_MS=2000       # delegation-row poll interval while waiting
