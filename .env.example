DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Jarvis peer delegation: Ares (Box 2 / augibot2) ---
# War Room "Approve & send to team" → dispatchDelegation() POSTs to
# {JARVIS_PEER_ARES_URL}/jarvis/dispatch as identity "ares" (Bearer JARVIS_PEER_ARES_TOKEN),
# then Ares POSTs the result back to /jarvis/delegations/:id/result to flip the row to completed.
# Runtime values are set in ~/.paperclip/instances/default/.env on Box 1 (secret not committed).
# JARVIS_PEER_ARES_URL=http://augibot2s-mac-mini.tail1537c5.ts.net:18790
# JARVIS_PEER_ARES_TOKEN=<shared bearer; == AUGUST_GATEWAY_TOKEN on augibot2>
# PAPERCLIP_BRIDGE_LOCAL_API_URL=http://<box1-tailnet-ip>:3100   # so Ares can reach the result callback

# --- Book Studio peers: Hermes Harness on Box 2 ---
# Calliope (brainstorm/creative) and Hades (review, Kimi K3) are named Hermes
# Harness agents. Both URL and TOKEN are mandatory for each identity. Book
# Studio deliberately does not inherit OPENCLAW_BRIDGE_URL/TOKEN or any shared
# default when one of these values is absent.
# JARVIS_PEER_CALLIOPE_URL=http://<box-2-host>:<hermes-harness-port>
# JARVIS_PEER_CALLIOPE_TOKEN=<calliope-specific-placeholder>
# JARVIS_PEER_HADES_URL=http://<box-2-host>:<hermes-harness-port>
# JARVIS_PEER_HADES_TOKEN=<hades-specific-placeholder>

# The Box 2 Hermes Harness executor must accept this dispatch path and route
# identityId "calliope" to Calliope and identityId "hades" to Hades. It must
# explicitly allow both identities before a live canary.
# JARVIS_DISPATCH_PATH=/agent/message

# The executor returns results to the callback URL included in each dispatch.
# Set this to a Paperclip API base reachable FROM Box 2 (not localhost on Box 2).
# PAPERCLIP_BRIDGE_LOCAL_API_URL=http://<paperclip-host-reachable-from-box-2>:3100

# Optional Book Studio wait limits (milliseconds).
# BOOK_CALLIOPE_TIMEOUT_MS=45000
# BOOK_HADES_TIMEOUT_MS=120000
